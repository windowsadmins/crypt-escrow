<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CryptEscrow.App</RootNamespace>
    <AssemblyName>Managed Encryption Escrow</AssemblyName>
    <Product>Managed Encryption Escrow</Product>
    <Description>Managed Encryption Escrow</Description>
    <Authors>Windows Admins</Authors>
    <Copyright>Copyright (c) 2026 Windows Admins. MIT License.</Copyright>
    <ApplicationIcon>Assets\ManagedEncryption.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- PRI generation needs a Visual Studio workload; build.ps1 runs makepri.exe after publish instead. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <!-- Field-based [ObservableProperty]; the partial-property form fails with the WinUI XAML compiler. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <BuildTimestamp>$([System.DateTime]::Now.ToString("yyyy.MM.dd.HHmm"))</BuildTimestamp>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$(BuildTimestamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CryptEscrow.Core\CryptEscrow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ManagedEncryption.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ManagedEncryption.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
