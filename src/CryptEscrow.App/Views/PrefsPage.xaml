<Page
    x:Class="CryptEscrow.App.Views.PrefsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gui="using:CryptEscrow.Gui"
    xmlns:local="using:CryptEscrow.App.Views"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="28,24,28,24">
            <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Center">

            <!-- ═══ App Info Header ═══ -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,4">
                <Image x:Name="AppIcon" Width="64" Height="64" HorizontalAlignment="Center" />

                <TextBlock Text="Managed Encryption Escrow"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Escrows this device's BitLocker recovery key to a Crypt server and rotates it on request."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" MaxWidth="500"
                           TextWrapping="WrapWholeWords" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <HyperlinkButton Content="Documentation"
                                     NavigateUri="https://github.com/windowsadmins/crypt-escrow#readme" />
                    <HyperlinkButton Content="Report Issue"
                                     NavigateUri="https://github.com/windowsadmins/crypt-escrow/issues" />
                </StackPanel>

                <TextBlock x:Name="VersionText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ═══ Policy banner: one line for every field set by policy ═══ -->
            <StackPanel x:Name="PolicyBanner" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Settings shown in gray have been configured by a policy."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ═══ Save bar: shown while there are unsaved changes or a save result ═══ -->
            <Grid x:Name="SaveBar" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" TextWrapping="WrapWholeWords"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel x:Name="SaveButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            Visibility="Collapsed">
                    <Button x:Name="DiscardButton" Content="Discard" Click="DiscardButton_Click" />
                    <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Save to this device's machine settings (asks for administrator approval)" />
                </StackPanel>
            </Grid>

            <!-- ═══ Settings Grid: 2×2 card layout, filled from the settings catalog ═══ -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="ConnectionCard" Spacing="8" />
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="AuthenticationCard" Spacing="8" />
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="EscrowCard" Spacing="8" />
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="LoggingCard" Spacing="8" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══ Services: the scheduled task the installer creates, read-only ═══ -->
            <Border x:Name="ServicesCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE912;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Services" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="RefreshServicesButton" HorizontalAlignment="Right" Click="RefreshServices_Click"
                                ToolTipService.ToolTip="Check the scheduled task again">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="What this tool's installer registers on the device. Expand one for its details."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ItemsControl x:Name="ServicesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gui:ComponentStatus">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4"
                                          ToolTipService.ToolTip="{x:Bind Description}">
                                    <!-- The header is the template's full-width toggle button, so a click
                                         anywhere on the row, Space or Enter expands and collapses it. -->
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12" Padding="0,6" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind FriendlyName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                         Fill="{x:Bind local:PrefsPage.StateBrush(StateBrushKey)}" />
                                                <TextBlock Text="{x:Bind State}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{x:Bind Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gui:ComponentDetail">
                                                <Grid ColumnSpacing="16" Padding="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ServicesAccessHint" Visibility="Collapsed"
                               Text="Task status needs administrator rights to read."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
