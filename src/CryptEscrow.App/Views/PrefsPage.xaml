<Page
    x:Class="CryptEscrow.App.Views.PrefsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gui="using:CryptEscrow.Gui"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="28,24,28,24">
            <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Center">

            <!-- ═══ App Info Header ═══ -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,4">
                <Image x:Name="AppIcon" Width="64" Height="64" HorizontalAlignment="Center" />

                <TextBlock Text="Managed Encryption Escrow"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Escrows this device's BitLocker recovery key to a Crypt server and rotates it on request."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" MaxWidth="500"
                           TextWrapping="WrapWholeWords" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <HyperlinkButton Content="Documentation"
                                     NavigateUri="https://github.com/windowsadmins/crypt-escrow#readme" />
                    <HyperlinkButton Content="Report Issue"
                                     NavigateUri="https://github.com/windowsadmins/crypt-escrow/issues" />
                </StackPanel>

                <TextBlock x:Name="VersionText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ═══ Policy banner: one line for every field set by policy ═══ -->
            <StackPanel x:Name="PolicyBanner" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Settings shown in gray have been configured by a policy."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ═══ Read-only banner: settings live in HKLM, so editing needs elevation ═══ -->
            <Border x:Name="ReadOnlyBanner" Style="{StaticResource CardStyle}" Padding="16,12">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords"
                                   Text="Settings are read-only. Unlock to change them (requires administrator)." />
                        <Button Grid.Column="2" x:Name="UnlockButton" Click="UnlockButton_Click"
                                ToolTipService.ToolTip="Relaunch as administrator to edit settings">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                <TextBlock Text="Unlock" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="UnlockErrorText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ElevatedNote" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Running as administrator. Changes save to this device's machine settings."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="SaveStatusText" HorizontalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />

            <!-- ═══ Settings Grid: 2×2 card layout, filled from the settings catalog ═══ -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="ConnectionCard" Spacing="8" />
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="AuthenticationCard" Spacing="8" />
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="EscrowCard" Spacing="8" />
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="LoggingCard" Spacing="8" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══ Services: the scheduled task the installer creates, read-only ═══ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE912;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Services" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="RefreshServicesButton" HorizontalAlignment="Right" Click="RefreshServices_Click"
                                ToolTipService.ToolTip="Check the scheduled task again">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="What this tool's installer registers on the device, and how it last ran."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="16" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="State" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="Last result" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="Runs" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>

                    <ItemsControl x:Name="ServicesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gui:ComponentStatus">
                                <Grid ColumnSpacing="16" Padding="0,6"
                                      ToolTipService.ToolTip="{x:Bind Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind FriendlyName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind State}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind LastResult}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Schedule}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ServicesAccessHint" Visibility="Collapsed"
                               Text="Windows lets only administrators read this task's details. Unlock to see them."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
