<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings, file trust and the pieces the CLI and the app both need. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CryptEscrow</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CryptEscrow.Tests" />
    <InternalsVisibleTo Include="checkin" />
    <InternalsVisibleTo Include="Managed Encryption Escrow" />
  </ItemGroup>

</Project>
