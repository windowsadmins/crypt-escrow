<Project Sdk="WixToolset.Sdk/6.0.1">
  <PropertyGroup>
    <OutputName>Crypt-$(Platform)</OutputName>
    <OutputType>Package</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <!-- ICE03: some WinUI resource DLLs carry locales (gd-gb, mi-NZ) missing from the ICE
         language table, and Microsoft.ui.xaml.dll lists more locales than the column holds. -->
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>

  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <BinDir Condition="'$(BinDir)' == ''">$(MSBuildProjectDirectory)\..\..\release\$(Platform)</BinDir>
    <AppDir Condition="'$(AppDir)' == ''">$(BinDir)\app</AppDir>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>BinDir=$(BinDir);AppDir=$(AppDir);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="6.0.1" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="Crypt.wxs" />
  </ItemGroup>
</Project>
