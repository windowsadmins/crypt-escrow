<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Crypt" 
           Manufacturer="Windows Admins Open Source" 
           Version="$(var.ProductVersion)"
           UpgradeCode="A1B2C3D4-E5F6-4A5B-8C9D-0E1F2A3B4C5D"
           Language="1033"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of Crypt is already installed." />
    
    <MediaTemplate EmbedCab="yes" />
    
    <Feature Id="ProductFeature" Title="Crypt" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
    
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Crypt">
        <Component Id="CryptExe" Bitness="always64">
          <File Id="checkin.exe" Source="$(var.BinDir)\checkin.exe" KeyPath="yes" />
          <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    
    <!-- The escrow task runs as SYSTEM and reads its config and state from here, so
         only SYSTEM and Administrators may write it: full control for both, Users read,
         nothing inherited from ProgramData. Same ACL as the package postinstall. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="ManagedEncryption">
        <Component Id="DataFolder" Guid="0E9CDB49-A0FA-49B0-BEF4-C5CE90F5C5B6" Bitness="always64">
          <CreateFolder>
            <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Credentials live in HKLM\SOFTWARE\Crypt\ManagedEncryption\Secrets, readable only by
         SYSTEM and Administrators. MSI fails the install if it cannot apply this ACL.
         The CLI moves any credential it finds in the readable policy or settings keys here. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Component Id="SecretsStore" Guid="4D2A9C61-7E3B-4F85-A1C6-2B9E0D7F5A38" Bitness="always64">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Crypt\ManagedEncryption\Secrets" ForceCreateOnInstall="yes">
          <PermissionEx Sddl="D:PAI(A;CI;KA;;;SY)(A;CI;KA;;;BA)" />
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="SOFTWARE\Crypt\ManagedEncryption" Name="SecretsStore" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents">
      <ComponentRef Id="CryptExe" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="SecretsStore" />
    </ComponentGroup>
    
    <CustomAction Id="RegisterScheduledTask" 
                  Directory="INSTALLFOLDER" 
                  Execute="deferred" 
                  Impersonate="no"
                  ExeCommand="[INSTALLFOLDER]checkin.exe register-task --frequency hourly"
                  Return="ignore" />
    
    <InstallExecuteSequence>
      <Custom Action="RegisterScheduledTask" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
